# Copier en .env (jamais versionné) et remplacer chaque valeur.
URGENCES_DB_USER=urgences
URGENCES_DB_PASSWORD=changer-moi
MYSQL_ROOT_PASSWORD=changer-moi-aussi
# 32 caractères minimum. Générer par ex. : openssl rand -base64 48
URGENCES_JWT_SECRET=remplacer-par-un-secret-aleatoire-de-48-caracteres
# Compte secours de démonstration (développement seulement, laisser vide en production).
URGENCES_DEV_RESPONDER_EMAIL=secours@demo.local
URGENCES_DEV_RESPONDER_PASSWORD=changer-moi-secours
